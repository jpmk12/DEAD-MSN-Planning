# Copy to .env and fill in to enable LIVE FAA NOTAMs.
# Register a free app at https://api.faa.gov to get these credentials.
# Without them, the app uses the bundled NOTAM fixture (offline/demo mode).
#
# .env is gitignored — never commit real credentials.

FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# FAA NMS-API fallback NOTAM source. DISABLED by default — DAIP is the
# authoritative source. Opt in with NMS_ENABLED=1 plus the creds below.
# NMS_ENABLED=1
# NMS_CLIENT_ID=
# NMS_CLIENT_SECRET=
# NMS_API_BASE=https://api-nms.aim.faa.gov   # or https://api-staging.cgifederal-aim.com

# Optional: live airspace via GeoJSON feature services (FAA ArcGIS / OpenAIP).
# When set, TFRs / SUA are pulled live and converted; otherwise fixtures are used.
# TFR_GEOJSON_URL=
# SUA_GEOJSON_URL=

# Saved sorties are stored in the browser (localStorage) — the app uses NO
# database, so there are no DB env vars to set. (Cross-device sync would require
# reintroducing a server-side store; see server/data/db.js.)

# Optional: SPC/CWA convective outlook GeoJSON override (defaults to SPC Day 1)
# CONVECTIVE_GEOJSON_URL=

# Optional: live Military Training Route (IR/VR) GeoJSON feed (FAA feature
# service). Without it, the app uses bundled demo routes.
# MTR_GEOJSON_URL=

# Optional: gate the /api/diag debug endpoint. When set, /api/diag requires
# ?key=<DIAG_KEY> and 404s otherwise. Leave unset only for local development.
# DIAG_KEY=

# Optional: whole-app access gate (HTTP Basic auth). When set, the site + API
# require these credentials (health checks stay exempt). Format "user:pass".
# APP_BASIC_AUTH=ops:change-me

# Optional: API rate limit (per IP). Defaults: 120 requests / 60s. 0 disables.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Optional: per-request access log to stdout (method/path/status/ms + proxy
# headers). OFF by default; set to "on" (or "1") to enable for debugging.
# REQUEST_LOG=on

# Optional: verbose startup diagnostics (prints platform paths + injected
# env-var NAMES — never values). Off by default; set to 1 if a deploy misbehaves.
# BOOT_DIAG=1

# Optional: override the HTTP port (defaults to 8787)
# PORT=8787
